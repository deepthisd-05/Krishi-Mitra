# SESSION_SECRET: Secret key for signing farmer/admin authentication cookies (auto-generated in local dev if omitted)
SESSION_SECRET="change-this-to-a-long-random-secret-in-production"

# SQLITE_DB_PATH: Optional file path for SQLite database (defaults to ./krishi_mitra.db)
SQLITE_DB_PATH="./krishi_mitra.db"

# DATA_GOV_API_KEY: Optional API key from data.gov.in for live Agmarknet mandi price queries.
# If omitted, Krishi Mitra serves the verified published APMC reference dataset with explicit reporting dates.
DATA_GOV_API_KEY=""

# GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Web Client ID for real Sign in with Google (Google Identity Services).
# Configure in environment variables / Secrets to enable the Sign in with Google button and ID token verification.
GOOGLE_CLIENT_ID=""

# GEMINI_API_KEY: Optional. Core crop calendar, weather, and Kannada voice Q&A run without an AI key.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
